# Estado e credenciais de transmissao ao vivo
youtube_credentials.json
*.sqlite3
*.jsonl
!tests/fixtures/*.jsonl

# Lancador da criacao automatica: gerado por `main.py auto --instalar`, com o
# caminho do Python e da pasta DESTA maquina dentro.
historias/auto.cmd
# Lancador do bot de Telegram: gerado por `python -m remoto --instalar`.
bot.cmd
# Saida do bot (o .cmd redireciona para ca).
outputs/bot.txt
# Lancador da postagem diaria: gerado por `ferramentas/postar.py --instalar`.
postar.cmd
# Saida da postagem (o .cmd redireciona para ca).
outputs/postar.txt
# Lancador da Vila flutuante: gerado por `python -m painel.flutuante.tarefa
# --instalar`, com o pythonw e a pasta de quem instalou dentro.
vila_flutuante.cmd
# Saida do app do celular (o app_celular.cmd redireciona para ca).
outputs/app_celular.txt
# Retratos crus do Studio do TikTok: JSON interno da conta DESTA maquina.
outputs/_tiktok/
# Patches que a apuracao automatica propoe: saida de maquina, um por erro.
outputs/_apuracoes/
# Relatorios da cura do ledger (`ferramentas/curar_ledger.py`): um por rodada.
outputs/_cura/
# Registro dos experimentos e a que braco cada producao foi sorteada: estado
# DESTA maquina, escrito pela pipeline a cada rodada.
outputs/_experimentos/

# A PASTA DO CLAUDE CODE. Os agentes por parte do projeto VAO para o
# repositorio: sao a metade "papel" dos documentos de docs/sessoes/ (o
# documento e o conhecimento, o agente e o que aquela parte faz e nunca faz).
# Todo o resto ali e estado desta maquina, e `worktrees/` chega a guardar
# copias inteiras do repositorio dentro do repositorio.
.claude/*
!.claude/agents/
!.claude/commands/
!.claude/settings.json
